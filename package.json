{
	"name": "@sv-pierre/words",
	"version": "0.2.0",
	"description": "A Svelte 5 wrapper for @pierre/words",
	"author": "SikandarJODD",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SikandarJODD/sv-pierre.git"
	},
	"bugs": {
		"url": "https://github.com/SikandarJODD/sv-pierre/issues"
	},
	"homepage": "https://github.com/SikandarJODD/sv-pierre#readme",
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"markdown",
		"streaming",
		"syntax-highlighting"
	],
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package -i src/lib/pierre/words && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/figtree": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/shantell-sans": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.76.0",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^5.1.0",
		"bits-ui": "^2.21.0",
		"cn": "^0.5.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"mode-watcher": "^1.1.0",
		"package-manager-detector": "^1.9.0",
		"pele": "^1.13.0",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.25",
		"runed": "^0.38.0",
		"shadcn-svelte": "^1.8.1",
		"shiki": "^3.23.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-meta-tags": "^5.0.3",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.5",
		"torph": "^0.1.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@pierre/highlights": "^0.5.1",
		"@pierre/words": "^0.3.0"
	}
}
